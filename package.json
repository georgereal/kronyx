{
	"name": "kronyx",
	"displayName": "Kronyx",
	"description": "Agentic coding in VS Code on the Cline SDK, with a run-oriented UI and Kronyx-owned file tools.",
	"version": "0.0.1",
	"publisher": "kronyx",
	"repository": {
		"type": "git",
		"url": "https://github.com/kronyx/kronyx"
	},
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"vscode": "^1.105.0",
		"node": ">=22"
	},
	"categories": [
		"AI",
		"Programming Languages"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "kronyx",
					"title": "Kronyx",
					"icon": "media/kronyx.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "kronyx-right",
					"title": "Kronyx",
					"icon": "media/kronyx.svg"
				}
			]
		},
		"views": {
			"kronyx": [
				{
					"id": "kronyx.agentsView",
					"name": "Agents",
					"type": "webview"
				},
				{
					"id": "kronyx.sessionView",
					"name": "Session",
					"type": "webview"
				}
			],
			"kronyx-right": [
				{
					"id": "kronyx.runViewRight",
					"name": "Session",
					"type": "webview"
				}
			]
		},
		"commands": [
			{
				"command": "kronyx.runTask",
				"title": "Run task",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.stop",
				"title": "Stop run",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.newTask",
				"title": "New task",
				"category": "Kronyx",
				"icon": "$(edit)"
			},
			{
				"command": "kronyx.setApiKey",
				"title": "Set API key",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.clearApiKey",
				"title": "Clear API key",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.focus",
				"title": "Show run view",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.focusRight",
				"title": "Show run view (right sidebar)",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.newSession",
				"title": "New session",
				"category": "Kronyx",
				"icon": "$(add)"
			},
			{
				"command": "kronyx.checkCloudSetup",
				"title": "Check cloud setup",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.newCloudSession",
				"title": "New cloud session (E2B + PR)",
				"category": "Kronyx",
				"icon": "$(cloud)"
			},
			{
				"command": "kronyx.reviewChanges",
				"title": "Review changes",
				"category": "Kronyx",
				"icon": "$(diff)"
			},
			{
				"command": "kronyx.acceptHunk",
				"title": "Accept hunk",
				"category": "Kronyx",
				"enablement": "false"
			},
			{
				"command": "kronyx.rejectHunk",
				"title": "Revert hunk",
				"category": "Kronyx",
				"enablement": "false"
			},
			{
				"command": "kronyx.dismissComments",
				"title": "Dismiss run comments",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.indexWorkspace",
				"title": "Index workspace for semantic memory",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.runEvals",
				"title": "Run eval suite",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.showHistory",
				"title": "Show run history",
				"category": "Kronyx",
				"icon": "$(history)"
			},
			{
				"command": "kronyx.showUsage",
				"title": "Show AI usage",
				"category": "Kronyx",
				"icon": "$(pulse)"
			},
			{
				"command": "kronyx.signIn",
				"title": "Sign in (GitHub)",
				"category": "Kronyx",
				"icon": "$(account)"
			},
			{
				"command": "kronyx.account",
				"title": "Account",
				"category": "Kronyx",
				"icon": "$(account)"
			},
			{
				"command": "kronyx.signOut",
				"title": "Sign out",
				"category": "Kronyx"
			},
			{
				"command": "kronyx.syncNow",
				"title": "Sync usage now",
				"category": "Kronyx",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "kronyx.openSettings",
				"title": "Open settings",
				"category": "Kronyx",
				"icon": "$(gear)"
			},
			{
				"command": "kronyx.openSettingsPage",
				"title": "Open settings page (custom UI)",
				"category": "Kronyx",
				"icon": "$(settings-gear)"
			},
			{
				"command": "kronyx.openSettingsWindow",
				"title": "Open settings window (browser)",
				"category": "Kronyx"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "kronyx.newSession",
					"when": "activeWebviewPanelId == 'kronyx.session'",
					"group": "navigation@1"
				},
				{
					"command": "kronyx.showHistory",
					"when": "activeWebviewPanelId == 'kronyx.session'",
					"group": "navigation@2"
				},
				{
					"command": "kronyx.reviewChanges",
					"when": "activeWebviewPanelId == 'kronyx.session'",
					"group": "navigation@3"
				},
				{
					"command": "kronyx.newTask",
					"when": "activeWebviewPanelId == 'kronyx.session'"
				},
				{
					"command": "kronyx.openSettingsPage",
					"when": "activeWebviewPanelId == 'kronyx.session'"
				},
				{
					"command": "kronyx.openSettings",
					"when": "activeWebviewPanelId == 'kronyx.session'"
				}
			],
			"view/title": [
				{
					"command": "kronyx.newSession",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight",
					"group": "navigation@1"
				},
				{
					"command": "kronyx.showHistory",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight",
					"group": "navigation@2"
				},
				{
					"command": "kronyx.showUsage",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight",
					"group": "navigation@3"
				},
				{
					"command": "kronyx.newCloudSession",
					"when": "(view == kronyx.sessionView || view == kronyx.runViewRight)",
					"group": "navigation@4"
				},
				{
					"command": "kronyx.signIn",
					"when": "(view == kronyx.sessionView || view == kronyx.runViewRight) && !kronyx.signedIn",
					"group": "navigation@5"
				},
				{
					"command": "kronyx.account",
					"when": "(view == kronyx.sessionView || view == kronyx.runViewRight) && kronyx.signedIn",
					"group": "navigation@5"
				},
				{
					"command": "kronyx.newTask",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight"
				},
				{
					"command": "kronyx.reviewChanges",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight"
				},
				{
					"command": "kronyx.openSettingsPage",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight"
				},
				{
					"command": "kronyx.openSettings",
					"when": "view == kronyx.sessionView || view == kronyx.runViewRight"
				}
			]
		},
		"keybindings": [
			{
				"command": "kronyx.focus",
				"key": "ctrl+alt+k",
				"mac": "cmd+alt+k"
			},
			{
				"command": "kronyx.newSession",
				"key": "ctrl+alt+shift+k",
				"mac": "cmd+alt+shift+k"
			}
		],
		"configuration": {
			"title": "Kronyx",
			"properties": {
				"kronyx.provider.id": {
					"type": "string",
					"default": "openai-compatible",
					"description": "Cline SDK provider id. Use openai-compatible for Vercel AI Gateway or any OpenAI-compatible endpoint."
				},
				"kronyx.provider.baseUrl": {
					"type": "string",
					"default": "https://ai-gateway.vercel.sh/v1",
					"description": "Base URL of the OpenAI-compatible API."
				},
				"kronyx.provider.modelId": {
					"type": "string",
					"default": "anthropic/claude-sonnet-4.6",
					"description": "Model id sent to the provider (Vercel AI Gateway uses provider/model)."
				},
				"kronyx.provider.models": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"label": {
								"type": "string"
							}
						}
					},
					"description": "Fallback model list shown in the model picker when the provider's /models endpoint is unreachable."
				},
				"kronyx.agent.defaultMode": {
					"type": "string",
					"enum": [
						"code",
						"smart",
						"ask",
						"plan",
						"bypass"
					],
					"default": "code",
					"description": "Agent mode used when none has been chosen in the run view."
				},
				"kronyx.agent.maxIterations": {
					"type": "number",
					"default": 40,
					"minimum": 1,
					"description": "Maximum agent steps per run."
				},
				"kronyx.sandbox.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Run the agent inside a sandbox. Planned — not yet enforced."
				},
				"kronyx.sandbox.backend": {
					"type": "string",
					"enum": [
						"local",
						"docker",
						"devcontainer",
						"e2b",
						"firecracker"
					],
					"default": "local",
					"description": "Sandbox backend. Planned — not yet enforced."
				},
				"kronyx.sandbox.image": {
					"type": "string",
					"default": "",
					"description": "Sandbox image or snapshot to boot. Planned — not yet enforced."
				},
				"kronyx.sandbox.cpus": {
					"type": "number",
					"default": 2,
					"minimum": 1,
					"description": "vCPUs for the sandbox. Planned — not yet enforced."
				},
				"kronyx.sandbox.memoryMb": {
					"type": "number",
					"default": 4096,
					"minimum": 256,
					"description": "Memory in MB for the sandbox. Planned — not yet enforced."
				},
				"kronyx.sandbox.host": {
					"type": "string",
					"default": "",
					"description": "Remote runner service URL for microVM backends (Firecracker needs Linux/KVM). Planned — not yet enforced."
				},
				"kronyx.sandbox.vendor": {
					"type": "string",
					"default": "",
					"description": "MicroVM vendor/provider identifier for the remote runner. Planned — not yet enforced."
				},
				"kronyx.cloud.pauseAfterRunMin": {
					"type": "number",
					"default": 12,
					"description": "Minutes to wait after a cloud run finishes before pausing its sandbox (cancels if a new task starts)"
				},
				"kronyx.cloud.idleTimeoutMin": {
					"type": "number",
					"default": 15,
					"minimum": 1,
					"description": "Minutes an E2B sandbox stays alive without activity (keepalive resets while runs are active)."
				},
				"kronyx.cloud.autoPr": {
					"type": "boolean",
					"default": true,
					"description": "Push the branch and open/update a GitHub PR when a cloud run finishes."
				},
				"kronyx.cloud.template": {
					"type": "string",
					"default": "",
					"description": "E2B template id/name for cloud sandboxes (blank = base image)."
				},
				"kronyx.cloud.ttlMinutes": {
					"type": "number",
					"default": 60,
					"description": "Sandbox lifetime cap in minutes."
				},
				"kronyx.cloud.idlePauseMinutes": {
					"type": "number",
					"default": 10,
					"description": "Beta-pause the sandbox after this many idle minutes (auto-resumes on next run). 0 disables."
				},
				"kronyx.cloud.defaultBase": {
					"type": "string",
					"default": "main",
					"description": "Base branch for cloud-run pull requests."
				},
				"kronyx.eval.gateOnModelChange": {
					"type": "string",
					"enum": [
						"prompt",
						"always",
						"off"
					],
					"default": "prompt",
					"description": "Gate model/profile changes on the eval suite: prompt to run it, always run it, or ignore."
				},
				"kronyx.eval.suite": {
					"type": "string",
					"default": ".kronyx/evals.json",
					"description": "Path to the eval suite file (JSON array or {cases: [...]}) relative to the workspace root."
				},
				"kronyx.memory.embeddingModel": {
					"type": "string",
					"default": "",
					"description": "Embedding model for semantic memory/code search (e.g. text-embedding-3-small). Empty disables the vector tier."
				},
				"kronyx.memory.topK": {
					"type": "number",
					"default": 5,
					"description": "Top semantic-search snippets injected into the agent context per run."
				},
				"kronyx.memory.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Load workspace rules/facts into the agent context and record feedback episodes."
				},
				"kronyx.checks.commands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Shell commands run as post-run checks (e.g. [\"npm run typecheck\", \"npm run test\"])."
				},
				"kronyx.checks.runOnFinish": {
					"type": "boolean",
					"default": false,
					"description": "Run checks automatically when a run completes."
				},
				"kronyx.provider.profile": {
					"type": "string",
					"default": "",
					"description": "Name of the active provider profile from kronyx.provider.profiles, or empty for the plain provider settings."
				},
				"kronyx.provider.profiles": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string"
							},
							"providerId": {
								"type": "string"
							},
							"baseUrl": {
								"type": "string"
							},
							"modelId": {
								"type": "string"
							}
						},
						"required": [
							"name"
						]
					},
					"description": "Named provider+model presets selectable in the settings page."
				},
				"kronyx.git.autoBranch": {
					"type": "boolean",
					"default": false,
					"description": "Create a git branch before each run."
				},
				"kronyx.git.branchPrefix": {
					"type": "string",
					"default": "kronyx/",
					"description": "Prefix for auto-created run branches."
				},
				"kronyx.git.commitOnFinish": {
					"type": "boolean",
					"default": false,
					"description": "Commit files changed by a run when it completes."
				},
				"kronyx.approval.autoApproveWrites": {
					"type": "boolean",
					"default": false,
					"description": "Apply file changes without asking."
				},
				"kronyx.sync.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Upload usage records to the Kronyx dashboard when signed in."
				},
				"kronyx.sync.providerKeys": {
					"type": "boolean",
					"default": true,
					"description": "Sync provider API keys to your Kronyx account for use on other devices and cloud sessions. Keys are stored on our servers — disable only if you don't accept that."
				},
				"kronyx.sync.endpoint": {
					"type": "string",
					"default": "http://localhost:3000",
					"description": "Base URL of the Kronyx web app (ingest API lives at /api/ingest). Change to your deployed app URL in production."
				}
			}
		}
	},
	"scripts": {
		"build": "node esbuild.mjs",
		"watch": "node esbuild.mjs --watch",
		"dev": "node esbuild.mjs && code --extensionDevelopmentPath=$PWD --user-data-dir=$PWD/.devhost/user-data --extensions-dir=$PWD/.devhost/extensions",
		"package": "node esbuild.mjs --production",
		"vsix": "node esbuild.mjs --production && vsce package --no-dependencies --allow-missing-repository",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src test",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm run test && npm run build"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/sql.js": "^1.4.11",
		"@types/vscode": "^1.105.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@cline/agents": "^0.2.0",
		"@cline/shared": "^0.2.0",
		"@opentelemetry/api": "~1.10.0",
		"@types/better-sqlite3": "^9.6.0",
		"better-sqlite3": "^13.0.3",
		"diff": "9.0.0",
		"e2b": "^2.62.0",
		"sql.js": "^1.15.2"
	}
}
