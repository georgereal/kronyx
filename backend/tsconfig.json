{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "../src/agent/**/*.ts", "../src/sandbox/sandboxCore.ts", "../src/tools/**/*.ts", "../src/diff/**/*.ts"],
	"exclude": ["../src/agent/memory.ts"]
}
