{
	"name": "kronyx-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node esbuild.mjs",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"start:embedded": "BACKEND_RUN_WORKER=1 node dist/index.js",
		"worker": "node dist/worker.js",
		"worker:dev": "node esbuild.mjs --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@cline/agents": "^0.2.0",
		"@cline/shared": "^0.2.0",
		"@kubernetes/client-node": "^2.0.2",
		"@vercel/sandbox": "^3.9.1",
		"diff": "9.0.0",
		"e2b": "^2.62.0",
		"firebase-admin": "^13.5.0",
		"ioredis": "^5.8.2",
		"mongodb": "^6.20.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.12",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3"
	}
}
