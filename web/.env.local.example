# Client-side Firebase config (safe to expose — identifies the project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kronyx-cfbdd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kronyx-cfbdd


# Server-only
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kronyx
# Firebase Admin service account — JSON string or path is fine
FIREBASE_SERVICE_ACCOUNT_JSON={
 
}

# Kronyx GitHub App (server-side token minting)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
